# Copy this file to .env and fill in real values.
# .env itself is gitignored — never commit real secrets.

# Flask/JWT signing secrets — generate random strings for production
# (e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# MySQL connection string. Locally this defaults to
# mysql+pymysql://root:@localhost/forge_dev if unset.
DATABASE_URL=mysql+pymysql://user:password@host:3306/forge_dev

# Comma-separated list of allowed frontend origins (no trailing slash).
# Locally this defaults to http://localhost:5173 if unset.
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# Set to "false" in production — the Flask debugger must never be exposed
# publicly (it lets anyone who can reach it run arbitrary code).
# (docker-compose.yml already forces this off via FORGE_ENV=production.)
FLASK_DEBUG=true

# "production" makes the app refuse to start on missing/placeholder secrets.
# docker-compose.yml sets it for you; leave unset for local development.
# FORGE_ENV=production

# Number of reverse proxies in front of the app (1 = nginx). 0 = none.
# TRUSTED_PROXY_COUNT=0

# Where sandbox work dirs are created. In Docker Compose this is
# /var/forge-tmp (bind-mounted at the same path on host and container).
# Leave unset when running the backend directly on your machine.
# SANDBOX_TMP_DIR=/var/forge-tmp

# Temporary escape hatch if C#/Java fail under Docker's default seccomp profile.
# SANDBOX_SECCOMP_UNCONFINED=false

# Used for the AI-assisted plagiarism verdicts (google-genai).
GEMINI_API_KEY=

# Institution settings (La Consolacion University).
# Domain of GENERATED student sign-in identifiers (<student_id>@student.com).
# These are identifiers only - not deliverable inboxes - and we do not own the domain.
STUDENT_EMAIL_DOMAIN=student.com
# OPTIONAL: restrict STAFF (instructor/administrator) emails to one domain.
# Leave empty until the university confirms its staff email rules.
ALLOWED_EMAIL_DOMAIN=
# The existing administrator account allowed to create or promote other
# administrators. Leave EMPTY until the real account is verified: while empty,
# creating/promoting administrators is disabled (ordinary sign-in still works).
# Never set this to an address you have not confirmed belongs to the right person.
# Preferred: verified, immutable user ID of the existing Head Admin. An invalid
# nonempty ID disables admin creation; it never falls back to matching a name.
HEAD_ADMIN_USER_ID=
# Legacy email-based configuration, used only when no ID is configured.
HEAD_ADMIN_EMAIL=
