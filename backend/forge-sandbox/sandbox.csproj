<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <DOTNET_CLI_TELEMETRY_OPTOUT>1</DOTNET_CLI_TELEMETRY_OPTOUT>
    <!-- ── ADD THESE TWO ─────────────────────────────────────────── -->
    <UseAppHost>true</UseAppHost>         <!-- Force apphost binary generation -->
    <SelfContained>false</SelfContained>  <!-- Use runtime from image, not bundled -->
  </PropertyGroup>
</Project>  