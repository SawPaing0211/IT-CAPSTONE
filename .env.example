# Root-level .env — read by `docker compose` itself (NOT by Flask) to fill
# in the ${MYSQL_ROOT_PASSWORD}/${MYSQL_DATABASE} placeholders in
# docker-compose.yml. Copy this to ".env" in the repo root (same folder as
# docker-compose.yml) before running `docker compose up`.
#
# This is separate from backend/.env, which Flask reads for its own config
# (SECRET_KEY, GEMINI_API_KEY, etc.) — docker-compose.yml wires
# DATABASE_URL for you using the values below, so you do NOT need to set
# DATABASE_URL yourself in backend/.env for this Docker Compose setup.

MYSQL_ROOT_PASSWORD=change-me-to-something-strong
MYSQL_DATABASE=forge_dev
